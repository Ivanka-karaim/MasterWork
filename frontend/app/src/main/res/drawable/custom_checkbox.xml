<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- стан "checked" -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/darkBlue"/> <!-- фіолетовий фон -->
            <corners android:radius="8dp"/>
        </shape>
    </item>

    <!-- стан "unchecked" -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white"/> <!-- білий фон -->
            <stroke android:width="2dp" android:color="@color/darkBlue"/> <!-- обводка -->
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
